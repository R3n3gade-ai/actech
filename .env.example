# =============================================================================
# Achelion ARMS — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in real values. The `.env` file is
# gitignored and must NEVER be committed.
#
# See docs/ARMS_API_CONNECTIONS_REQUIRED.md for full setup instructions.
# =============================================================================

# --- LLM Configuration -------------------------------------------------------
# Set ONE provider key. The wrapper auto-detects provider from the model name.
OPENAI_API_KEY=sk-proj-REPLACE_ME
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# GEMINI_API_KEY=REPLACE_ME

# Active model — wrapper auto-detects provider from name (gpt*, claude*, gemini*)
DEFAULT_LLM_MODEL=gpt-5.5

# --- FRED (Federal Reserve Economic Data) ------------------------------------
# Free, instant signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=REPLACE_ME

# --- IBKR Gateway / TWS ------------------------------------------------------
# Paper trading port: 4002 | Live port: 4001
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# --- SEC EDGAR ---------------------------------------------------------------
# Required user-agent string per SEC fair-access policy
ARMS_SEC_USER_AGENT=Achelion ARMS ops@yourcompany.com

# --- System Control ----------------------------------------------------------
# 1 = enforce live data only (reject cached fallbacks). Use 0 in dev.
ARMS_STRICT_LIVE=1

# --- AWS Infrastructure (production deployment only) -------------------------
# AWS_REGION=us-east-1
# ARMS_ENVIRONMENT=prod
# ARMS_S3_STATE_BUCKET=achelion-arms-state
# ARMS_S3_BACKUP_PREFIX=backups/
# ARMS_SNS_ALERT_TOPIC=arn:aws:sns:us-east-1:ACCOUNT:arms-alerts

# --- RDS PostgreSQL (production only; falls back to JSON locally) ------------
# ARMS_PG_HOST=
# ARMS_PG_PORT=5432
# ARMS_PG_DATABASE=arms
# ARMS_PG_USER=arms_app
# ARMS_PG_PASSWORD=
# ARMS_PG_SSL_MODE=require

# --- ElastiCache Redis (production only; falls back to in-memory locally) ----
# ARMS_REDIS_HOST=
# ARMS_REDIS_PORT=6379
# ARMS_REDIS_DB=0
# ARMS_REDIS_PASSWORD=
# ARMS_REDIS_SSL=true

# --- Vector KB (Pinecone, optional; falls back to local JSON) ----------------
# ARMS_VECTOR_STORE=local
# PINECONE_API_KEY=
# ARMS_PINECONE_INDEX=arms-kb
# PINECONE_ENVIRONMENT=us-east-1
# ARMS_EMBEDDING_MODEL=text-embedding-3-small

# --- Anticipatory Intelligence APIs (optional) -------------------------------
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
